<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="exercise-2"/>
        <attribute name="authors" value="User"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-06-30 03:04:04 PM"/>
        <attribute name="created" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNi0zMDswMjo1Mjo1MCBQTTsyNzQ4"/>
        <attribute name="edited" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNi0zMDswMzowNDowNCBQTTsxOzI4NTM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="length" type="Real" array="False" size=""/>
            <input variable="length"/>
            <declare name="lengthtotal" type="Real" array="False" size=""/>
            <assign variable="lengthtotal" expression="length+(length*0.1)"/>
            <declare name="price" type="Real" array="False" size=""/>
            <assign variable="price" expression="5"/>
            <declare name="totalprice" type="Real" array="False" size=""/>
            <assign variable="totalprice" expression="lengthtotal*price"/>
            <output expression="totalprice" newline="True"/>
        </body>
    </function>
</flowgorithm>
