<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="lab-4-1"/>
        <attribute name="authors" value="User"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-06 08:15:18 AM"/>
        <attribute name="created" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0wNjswODowNzoyOCBBTTsyNzQ4"/>
        <attribute name="edited" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0wNjswODoxNToxOCBBTTsxOzI4NTQ="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="kWh" type="Real" array="False" size=""/>
            <declare name="totalBill" type="Real" array="False" size=""/>
            <input variable="kWh"/>
            <if expression="kWh &gt;= 100">
                <then>
                    <if expression="kWh &gt; 200">
                        <then>
                            <assign variable="totalBill" expression="kWh*0.75"/>
                        </then>
                        <else>
                            <assign variable="totalBill" expression="kWh*0.5"/>
                        </else>
                    </if>
                </then>
                <else>
                    <assign variable="totalBill" expression="kWh*0.3"/>
                </else>
            </if>
            <output expression="totalBill" newline="True"/>
        </body>
    </function>
</flowgorithm>
