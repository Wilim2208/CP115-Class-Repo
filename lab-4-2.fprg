<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="lab-4-2"/>
        <attribute name="authors" value="User"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-06 08:40:14 AM"/>
        <attribute name="created" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0wNjswODozNTozMyBBTTsyNzQ1"/>
        <attribute name="edited" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0wNjswODo0MDoxNCBBTTsxOzI4NDg="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="income" type="Real" array="False" size=""/>
            <input variable="income"/>
            <declare name="totalTax" type="Real" array="False" size=""/>
            <if expression="income &gt; 50000">
                <then>
                    <if expression="income &gt; 100000">
                        <then>
                            <assign variable="totalTax" expression="income+(income*0.2)"/>
                        </then>
                        <else>
                            <assign variable="totalTax" expression="income+(income*0.1)"/>
                        </else>
                    </if>
                </then>
                <else>
                    <assign variable="totalTax" expression="income"/>
                </else>
            </if>
            <output expression="totalTax" newline="True"/>
        </body>
    </function>
</flowgorithm>
