<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="lab-4-3"/>
        <attribute name="authors" value="User"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-06 09:21:56 AM"/>
        <attribute name="created" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0wNjswOTowNjoyMCBBTTsyNzQw"/>
        <attribute name="edited" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0wNjswOToyMTo1NiBBTTsxOzI4NTQ="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="hour" type="Integer" array="False" size=""/>
            <declare name="parkingFee" type="Integer" array="False" size=""/>
            <declare name="capped" type="Integer" array="False" size=""/>
            <input variable="hour"/>
            <if expression="hour &gt; 2">
                <then>
                    <if expression="hour &gt; 5">
                        <then>
                            <assign variable="parkingFee" expression="hour*3"/>
                        </then>
                        <else>
                            <assign variable="parkingFee" expression="hour*2"/>
                        </else>
                    </if>
                </then>
                <else>
                    <assign variable="parkingFee" expression="0"/>
                </else>
            </if>
            <if expression="parkingFee &gt; 30">
                <then>
                    <assign variable="capped" expression="30"/>
                    <output expression="capped" newline="True"/>
                </then>
                <else>
                    <output expression="parkingFee" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
